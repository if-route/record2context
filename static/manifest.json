{
  "manifest_version": 3,
  "name": "record2context",
  "version": "0.1.0",
  "description": "Record what you did in a tab (video, actions, network, marks with notes) as context for an AI.",
  "key": "",
  "minimum_chrome_version": "127",
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "record2context",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png",
      "48": "icons/48.png",
      "128": "icons/128.png"
    }
  },
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "permissions": [
    "tabCapture",
    "offscreen",
    "scripting",
    "storage",
    "unlimitedStorage",
    "activeTab",
    "nativeMessaging"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "commands": {
    "toggle-recording": {
      "suggested_key": {
        "default": "Alt+Shift+R"
      },
      "description": "Start or stop recording this tab"
    },
    "screenshot": {
      "suggested_key": {
        "default": "Alt+Shift+S"
      },
      "description": "Screenshot: pause, capture this tab, draw and write a note"
    }
  }
}
